{
  "info": {
    "name": "Employee Manager - Lab 05",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nimal Perera\",\n  \"email\": \"nimal.perera@example.com\",\n  \"phone\": \"0771234567\",\n  \"department\": \"Engineering\",\n  \"salary\": 75000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('employeeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees"
      }
    },
    {
      "name": "Find employee",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      }
    },
    {
      "name": "Search by name",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees?keyword=nimal"
      }
    },
    {
      "name": "Reject duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nimal Perera\",\n  \"email\": \"nimal.perera@example.com\",\n  \"phone\": \"0771234567\",\n  \"department\": \"Engineering\",\n  \"salary\": 75000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate rejected', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nimal Perera\",\n  \"email\": \"invalid\",\n  \"phone\": \"12345\",\n  \"department\": \"Engineering\",\n  \"salary\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid data rejected', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nimal Perera\",\n  \"email\": \"nimal.perera@example.com\",\n  \"phone\": \"0771234567\",\n  \"department\": \"Finance\",\n  \"salary\": 90000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No longer exists', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
